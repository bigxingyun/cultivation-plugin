{
  "name": "koshi",
  "private": true,
  "version": "0.1.0",
  "description": "修仙挂机 Koishi 插件 · 开发工作区",
  "workspaces": [
    "external/*"
  ],
  "scripts": {
    "build": "npm run build -w koishi-plugin-demo && npm run build -w koishi-plugin-xianxia-idle",
    "dev": "npm run build && cross-env NODE_ENV=development koishi start -r esbuild-register -r yml-register",
    "start": "cross-env NODE_ENV=production koishi start",
    "smoke": "node -r esbuild-register scripts/smoke-test.ts",
    "smoke:game": "node -r esbuild-register scripts/smoke-xianxia.ts",
    "probe:style": "node -r esbuild-register scripts/probe-style.ts",
    "golden": "node -r esbuild-register scripts/golden-render.ts",
    "golden:check": "node -r esbuild-register scripts/golden-render.ts --check",
    "gen": "node scripts/gen-techniques.mjs && node scripts/gen-pills.mjs && node scripts/gen-chains.mjs && node scripts/gen-story-data.mjs",
    "dep": "yakumo dep"
  },
  "dependencies": {
    "@koishijs/client": "^5.30.11",
    "@koishijs/plugin-actions": "^0.0.2",
    "@koishijs/plugin-adapter-qq": "^4.14.0",
    "@koishijs/plugin-admin": "^2.0.0",
    "@koishijs/plugin-analytics": "^2.0.6",
    "@koishijs/plugin-auth": "^4.1.7",
    "@koishijs/plugin-bind": "^1.5.1",
    "@koishijs/plugin-commands": "^3.5.5",
    "@koishijs/plugin-config": "^2.8.6",
    "@koishijs/plugin-console": "^5.30.11",
    "@koishijs/plugin-database-sqlite": "^4.7.0",
    "@koishijs/plugin-explorer": "^1.5.5",
    "@koishijs/plugin-help": "^2.4.6",
    "@koishijs/plugin-http": "^0.6.3",
    "@koishijs/plugin-insight": "^3.5.2",
    "@koishijs/plugin-inspect": "^1.1.7",
    "@koishijs/plugin-locales": "^2.5.3",
    "@koishijs/plugin-logger": "^2.6.9",
    "@koishijs/plugin-market": "^2.11.11",
    "@koishijs/plugin-notifier": "^1.2.1",
    "@koishijs/plugin-oobe": "^0.0.2",
    "@koishijs/plugin-proxy-agent": "^0.3.3",
    "@koishijs/plugin-sandbox": "^3.4.2",
    "@koishijs/plugin-server": "^3.2.9",
    "@koishijs/plugin-status": "^7.4.10",
    "koishi": "^4.18.11",
    "koishi-plugin-assets-local": "^3.3.2",
    "koishi-plugin-dataview": "^2.7.8",
    "koishi-plugin-demo": "workspace:*",
    "koishi-plugin-rate-limit": "^2.0.4",
    "koishi-plugin-theme-vanilla": "^1.1.0",
    "koishi-plugin-xianxia-idle": "workspace:*"
  },
  "devDependencies": {
    "@koishijs/plugin-mock": "^2.6.6",
    "cross-env": "^7.0.3",
    "esbuild-register": "^3.6.0",
    "typescript": "^5.6.3",
    "yml-register": "^1.2.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "vue-demi@0.14.10": true
  }
}
