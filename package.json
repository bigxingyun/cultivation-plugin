{
  "name": "koshi",
  "private": true,
  "version": "0.1.0",
  "description": "修仙挂机 Koishi 插件 · 开发工作区",
  "workspaces": [
    "external/*"
  ],
  "scripts": {
    "build": "npm run build -w koishi-plugin-demo && npm run build -w koishi-plugin-xianxia-idle",
    "dev": "npm run build && cross-env NODE_ENV=development koishi start -r esbuild-register -r yml-register",
    "start": "cross-env NODE_ENV=production koishi start",
    "smoke": "node -r esbuild-register scripts/smoke-test.ts",
    "smoke:game": "node -r esbuild-register scripts/smoke-xianxia.ts",
    "probe:style": "node -r esbuild-register scripts/probe-style.ts",
    "gen": "node scripts/gen-techniques.mjs && node scripts/gen-pills.mjs && node scripts/gen-chains.mjs && node scripts/gen-story-data.mjs",
    "dep": "yakumo dep"
  },
  "dependencies": {
    "@koishijs/client": "^5.30.11",
    "@koishijs/plugin-console": "^5.30.11",
    "@koishijs/plugin-database-sqlite": "^4.7.0",
    "@koishijs/plugin-http": "^0.6.3",
    "@koishijs/plugin-logger": "^2.6.9",
    "@koishijs/plugin-proxy-agent": "^0.3.3",
    "@koishijs/plugin-sandbox": "^3.4.2",
    "koishi": "^4.18.11",
    "koishi-plugin-demo": "workspace:*"
  },
  "devDependencies": {
    "@koishijs/plugin-mock": "^2.6.6",
    "cross-env": "^7.0.3",
    "esbuild-register": "^3.6.0",
    "typescript": "^5.6.3",
    "yml-register": "^1.2.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "vue-demi@0.14.10": true
  }
}
